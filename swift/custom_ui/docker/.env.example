# MS-SWIFT Custom UI 环境配置示例
# 复制此文件为 .env 并根据需要修改配置

# ===== GPU 配置 =====
# GPU 数量: 1, 2, all 等
GPU_COUNT=1

# CUDA 可见设备: 0, 0,1, 0,1,2,3 等
# 单卡: CUDA_VISIBLE_DEVICES=0
# 双卡: CUDA_VISIBLE_DEVICES=0,1
# 指定第2和第3块卡: CUDA_VISIBLE_DEVICES=1,2
CUDA_VISIBLE_DEVICES=0

# ===== 端口配置 =====
# API 访问端口
API_PORT=8000

# ===== 目录配置 =====
# 数据目录（相对或绝对路径）
DATA_DIR=./data

# 模型目录（相对或绝对路径）
MODEL_DIR=./models

# 输出目录（相对或绝对路径）
OUTPUT_DIR=./output

# ===== 使用示例 =====
# 1. 单卡场景（默认）
#    GPU_COUNT=1
#    CUDA_VISIBLE_DEVICES=0

# 2. 使用第2块GPU
#    GPU_COUNT=1
#    CUDA_VISIBLE_DEVICES=1

# 3. 使用2块GPU（第1和第2块）
#    GPU_COUNT=2
#    CUDA_VISIBLE_DEVICES=0,1

# 4. 使用所有GPU
#    GPU_COUNT=all
#    CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

# 5. 使用指定的非连续GPU（第1、第3、第5块）
#    GPU_COUNT=3
#    CUDA_VISIBLE_DEVICES=0,2,4
