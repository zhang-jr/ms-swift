# MS-SWIFT Custom UI 环境配置示例
# 复制此文件为 .env 并根据需要修改配置

# ===== GPU 配置 =====
# GPU 数量: 1, 2, all 等
GPU_COUNT=1

# CUDA 可见设备: 0, 0,1, 0,1,2,3 等
# 单卡: CUDA_VISIBLE_DEVICES=0
# 双卡: CUDA_VISIBLE_DEVICES=0,1
# 指定第2和第3块卡: CUDA_VISIBLE_DEVICES=1,2
CUDA_VISIBLE_DEVICES=0

# ===== 端口配置 =====
# API 访问端口
API_PORT=8000

# ===== 目录配置 =====
# 数据目录（相对路径或绝对路径）
# 相对路径: ./data (相对于 docker-compose.yml 所在目录)
# 绝对路径: /mnt/data/ms-swift-data
DATA_DIR=./data

# 模型目录（相对路径或绝对路径）
# 相对路径: ./models
# 绝对路径: /mnt/models 或 /home/user/models
# 说明: 建议使用大容量磁盘存储模型
MODEL_DIR=./models

# 输出目录（相对路径或绝对路径）
# 相对路径: ./output
# 绝对路径: /mnt/output/ms-swift
OUTPUT_DIR=./output

# 数据集缓存目录（Apache Arrow 格式缓存）
# 说明: Hugging Face Datasets 库会将原始数据（CSV/JSONL）转换为 Arrow 格式缓存
#       这个缓存会比原始文件大 5-10%，但训练时读取更快
# 建议: 使用临时目录或单独的缓存盘，训练完成后可以删除
# 相对路径: ./datasets_cache
# 绝对路径: /tmp/datasets_cache 或 /mnt/cache/datasets
DATASETS_CACHE_DIR=./datasets_cache

# ===== 完整配置示例 =====

# 示例 1: 单卡 + 默认路径（开发环境）
# GPU_COUNT=1
# CUDA_VISIBLE_DEVICES=0
# DATA_DIR=./data
# MODEL_DIR=./models
# OUTPUT_DIR=./output

# 示例 2: 使用第2块GPU + 默认路径
# GPU_COUNT=1
# CUDA_VISIBLE_DEVICES=1
# DATA_DIR=./data
# MODEL_DIR=./models
# OUTPUT_DIR=./output

# 示例 3: 双卡 + 自定义绝对路径（生产环境）
# GPU_COUNT=2
# CUDA_VISIBLE_DEVICES=0,1
# DATA_DIR=/mnt/data/ms-swift
# MODEL_DIR=/mnt/ssd/models
# OUTPUT_DIR=/mnt/ssd/output

# 示例 4: 所有GPU + 挂载NFS共享存储
# GPU_COUNT=all
# CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
# DATA_DIR=/nfs/shared/data
# MODEL_DIR=/nfs/shared/models
# OUTPUT_DIR=/mnt/local-ssd/output

# 示例 5: 指定非连续GPU + 混合路径
# GPU_COUNT=3
# CUDA_VISIBLE_DEVICES=0,2,4
# DATA_DIR=/home/user/datasets
# MODEL_DIR=/mnt/nvme/models
# OUTPUT_DIR=./output

# 示例 6: Windows 路径格式（Docker Desktop for Windows）
# GPU_COUNT=1
# CUDA_VISIBLE_DEVICES=0
# DATA_DIR=/host_mnt/d/data/ms-swift
# MODEL_DIR=/host_mnt/d/models
# OUTPUT_DIR=/host_mnt/d/output

# ===== 路径规划建议 =====
# - DATA_DIR: 训练数据集（原始数据），需要快速读取，建议 SSD
# - MODEL_DIR: 预训练模型，体积大，建议大容量存储（可以是HDD）
# - OUTPUT_DIR: 训练输出（checkpoints、logs），频繁写入，建议 SSD/NVMe
# - DATASETS_CACHE_DIR: Arrow 格式缓存，临时文件，建议使用 /tmp 或单独缓存盘

# ===== 缓存清理建议 =====
# 训练完成后可以删除 DATASETS_CACHE_DIR 目录以释放空间：
# docker exec ms-swift-ui rm -rf /app/datasets_cache/*
# 下次训练时会自动重新生成缓存
